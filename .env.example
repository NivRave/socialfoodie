# Gemini API configuration for LLM extraction and embeddings
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL connection string
# Defaults to local docker-compose configuration
DATABASE_URL=postgres://foodie_user:foodie_password@localhost:5433/socialfoodie?sslmode=disable

# RabbitMQ configuration
# Defaults to local docker-compose configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_USER=foodie_mq
RABBITMQ_PASS=foodie_mq_pass
