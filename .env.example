# Gemini API configuration for LLM extraction and embeddings
GEMINI_API_KEY=your_gemini_api_key_here

# Container Secrets (required for docker-compose)
POSTGRES_PASSWORD=foodie_password_change_me
RABBITMQ_DEFAULT_PASS=foodie_mq_pass_change_me

# PostgreSQL connection string (for running components natively outside docker)
DATABASE_URL=postgres://foodie_user:${POSTGRES_PASSWORD}@localhost:5433/socialfoodie?sslmode=disable

# RabbitMQ configuration (for running components natively outside docker)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_USER=foodie_mq
RABBITMQ_PASS=${RABBITMQ_DEFAULT_PASS}
